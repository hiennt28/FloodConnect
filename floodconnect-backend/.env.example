# --- Security ---
# REQUIRED: random string of at least 32 bytes used to sign JWT access tokens.
# Generate one in PowerShell: $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=

# ROOT admin account created on the FIRST run (when the database has no admin yet). Only the root admin can create,
# disable and re-enable other admin accounts (page "Quản lý Admin"); other admins get their own password by email.
# ADMIN_PASSWORD is REQUIRED for that first run: at least 8 characters with letters and digits, not "Admin12345".
# Changing these later does NOT change an existing admin; change the password in the profile page instead.
ADMIN_EMAIL=nhomdoan2004@gmail.com
ADMIN_PHONE=0900000000
ADMIN_PASSWORD=

# --- Email configuration ---
MAIL_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your.email@gmail.com
# Gmail App Password (16 characters), do not use your Gmail login password
MAIL_PASSWORD=your_gmail_app_password
# Optional: defaults to MAIL_USER
# MAIL_FROM=your.email@gmail.com

# Frontend URL used in email verification links
FRONTEND_URL=http://localhost:5173

# --- Cloudinary storage ---
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# Organization legal documents / ID cards are stored PRIVATELY (Cloudinary "authenticated" type, or this folder when
# STORAGE_PROVIDER=local; the folder is not served over the web, remember to back it up)
STORAGE_PRIVATE_DIR=./private-uploads
# Set true ONCE to move old publicly stored org documents to private storage, then set back to false
MIGRATE_ORG_DOCS=false

# --- Payment configuration ---
PAYMENT_MOCK=false
BACKEND_URL=http://localhost:8080

# VNPay sandbox
# Register at https://sandbox.vnpayment.vn/devreg/
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret

# --- API documentation (Swagger UI at /swagger-ui.html) ---
# true only for development/demo; keep false when deployed so outsiders cannot browse the API list
SWAGGER_ENABLED=false

# --- Auth rate limiting (per IP, per minute) ---
# Set to false to disable, e.g. for automated tests or a demo where many people share one IP
AUTH_RATE_LIMIT_ENABLED=true
# Only set true when running behind a reverse proxy that writes X-Forwarded-For
TRUST_PROXY=false

# --- Donation amount limits (VND per donation) ---
# Defaults follow VNPay's commonly reported limits (5,000 to under 1 billion); not confirmed against official docs, adjust if the sandbox differs
PAYMENT_MIN_AMOUNT=5000
PAYMENT_MAX_AMOUNT=999999999

# --- Admin dispatch map ---
# Max SOS cases per load of /api/admin/sos/map (active cases first, then most recently ended); above it the UI asks to narrow the filter
MAP_MAX_MARKERS=1000
# Max active SOS cases per load of /api/sos/active (dispatch page, "Tất cả" tab, maps); above it the UI shows a notice
SOS_ACTIVE_MAX=1000

# --- Optional settings (defaults in application.yml) ---
# Uncomment a line ONLY to change it: an empty value (NAME=) overrides the default with an empty string.
# Database (default: jdbc:postgresql://localhost:5432/floodconnect, postgres / postgres)
# DB_URL=
# DB_USER=
# DB_PASSWORD=
# Hibernate only validates the schema; Flyway manages it (default: validate)
# DDL_AUTO=
# true ONCE for a database created before Flyway (see README), then back to false (default: false)
# FLYWAY_BASELINE=
# Allowed frontend origins, comma separated (default: http://localhost:5173,http://localhost:3000)
# CORS_ORIGINS=
# Insert demo data on start (default: false)
# SEED_DATA=
# Local storage when STORAGE_PROVIDER=local (default: ./uploads served at http://localhost:8080/files)
# STORAGE_DIR=
# STORAGE_PUBLIC_URL=
# Cloudinary root folder (default: floodconnect)
# CLOUDINARY_FOLDER=
# VNPay payment page (default: sandbox https://sandbox.vnpayment.vn/paymentv2/vpcpay.html)
# VNPAY_PAY_URL=
# Unpaid donations become EXPIRED after this many minutes (default: 30)
# PAYMENT_PENDING_EXPIRE_MINUTES=
# AI Matching (W score): only refusals / no-responses within this many recent hours lower the score (default: 3)
# MATCHING_REFUSAL_WINDOW_HOURS=
# Remind org and admins when a case stays "Đã tiếp nhận" longer than this many hours (default: 2)
# ACCEPTED_REMINDER_HOURS=
# An assigned case whose organisation did not answer within 5 minutes returns to "Chờ xử lý" after this many more minutes
# if no admin has reassigned it (default: 10). Keep ASSIGN_RELEASE_MIN in the frontend (src/utils/constants.js) the same
# ASSIGN_RELEASE_MINUTES=
# AI service floodconnect-ai (assessment + matching), e.g. http://localhost:8000; empty = built-in Java rules (default: empty)
# AI_SERVICE_URL=http://localhost:8000
# Same value as ADMIN_TOKEN of the AI service (header X-API-Token); empty when the AI service runs in demo mode
# AI_TOKEN=
# Connect timeout in ms (read timeout = 3x) and how long to use the Java rules after an AI failure (defaults: 3000, 30)
# AI_TIMEOUT_MS=
# AI_RETRY_AFTER_SECONDS=
# Neighbour cases sent to the AI for clustering (defaults: 1000 m, 360 minutes)
# AI_CLUSTER_RADIUS_M=
# AI_CLUSTER_WINDOW_MINUTES=
# Matching via AI: shared service radius (km) and capacity (cases at once) for every organisation (defaults: 35, 3)
# AI_ORG_SERVICE_RADIUS_KM=
# AI_ORG_DEFAULT_CAPACITY=
# Open-Meteo weather lookups for SOS assessment (default: true)
# WEATHER_ENABLED=
