# Nhà cung cấp bản đồ. Miễn phí, không cần khóa: esri (địa hình, mặc định), openfreemap, osm. Cần khóa: goong, maptiler
VITE_MAP_PROVIDER=esri
# Khóa API (bắt buộc với goong / maptiler). Goong: đăng ký tại https://account.goong.io
VITE_MAP_API_KEY=

# Địa chỉ backend Spring Boot
VITE_API_URL=http://localhost:8080